  <dialog id="img-modal" class="bg-transparent p-0 m-auto max-w-6xl w-[calc(100%-2rem)] backdrop:bg-black/80 backdrop:backdrop-blur-sm open:animate-[fade-in_150ms_ease-out]">
    <div class="relative">
      <button type="button" id="img-modal-close" class="absolute -top-10 right-0 text-white/70 hover:text-white text-sm font-medium cursor-pointer transition-colors">
        Close <span class="ml-1 text-xs text-white/40">ESC</span>
      </button>
      <img id="img-modal-src" class="w-full rounded-xl" src="" alt="" />
    </div>
  </dialog>

  <script>
    const dialog = document.getElementById('img-modal') as HTMLDialogElement;
    const modalImg = document.getElementById('img-modal-src') as HTMLImageElement;
    const closeBtn = document.getElementById('img-modal-close')!;

    document.querySelectorAll('.img-preview').forEach(btn => {
      btn.addEventListener('click', () => {
        const img = btn.querySelector('img');
        if (!img) return;
        modalImg.src = img.currentSrc || img.src;
        modalImg.alt = img.alt;
        dialog.showModal();
      });
    });

    closeBtn.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  </script>
</BaseLayout>
