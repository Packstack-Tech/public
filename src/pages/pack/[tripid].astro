---
import PackPageContent from "../../components/PackPageContent"
import BaseLayout from "../../layouts/BaseLayout.astro"
import PageHeader from "../../components/PageHeader.astro"
import PageFooter from "../../components/PageFooter.astro"
const { tripid } = Astro.params
const resp = await fetch(`https://api.packstack.io/trip/meta/${tripid}`)
const data = await resp.json()
---

<BaseLayout title={`${data.trip.location || data.trip.title} :: Packstack`}>
  <div class="bg-background min-h-screen flex flex-col">
    <PageHeader maxWidth="full" />
    <PackPageContent trip={data.trip} user={data.user} client:load />
    <PageFooter />
  </div>
</BaseLayout>
