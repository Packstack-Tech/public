---
import "../styles/global.css"

interface Props {
  title: string
  description?: string
}

const { title, description = "Plan your backpacking trips with Packstack, the gear list builder and base weight tracker built for backpackers. Track every gram, organize by category, and share your setup." } = Astro.props
---

<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18325743425"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-18325743425');
    </script>

    <!-- Ad attribution: remember the ad click / UTM tags this visit landed with and carry them
         to app.packstack.io, where registration sends them to the API. The API reports real
         sign-ups and purchases to Google Ads; see app/src/lib/attribution.ts. -->
    <script is:inline>
      (function () {
        var KEYS = ['gclid', 'gbraid', 'wbraid', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
        var CLICK_IDS = ['gclid', 'gbraid', 'wbraid'];
        var MAX_AGE_S = 90 * 24 * 60 * 60; // Google's longest click-conversion window
        var onPackstack = /(^|\.)packstack\.io$/.test(location.hostname);
        function hasClick(a) { return !!a && CLICK_IDS.some(function (k) { return !!a[k]; }); }
        function read() {
          try {
            var m = document.cookie.match(/(?:^|; )ps_attr=([^;]*)/);
            var a = m ? JSON.parse(decodeURIComponent(m[1])) : null;
            return a && a.ts && Date.now() - a.ts < MAX_AGE_S * 1000 ? a : null;
          } catch (e) { return null; }
        }
        var stored = read();
        try {
          var params = new URLSearchParams(location.search);
          var found = {};
          KEYS.forEach(function (k) { var v = params.get(k); if (v) found[k] = v.slice(0, 255); });
          // A visit with only UTM tags never replaces a stored ad click.
          if (Object.keys(found).length && (hasClick(found) || !hasClick(stored))) {
            found.ts = Date.now();
            found.landing = location.pathname.slice(0, 255);
            document.cookie = 'ps_attr=' + encodeURIComponent(JSON.stringify(found)) +
              '; path=/; max-age=' + MAX_AGE_S + '; SameSite=Lax; Secure' +
              (onPackstack ? '; domain=.packstack.io' : '');
            stored = found;
          }
        } catch (e) {}
        if (!stored) return;
        // Safari can cap script-set cookies at a day or a week, so also put the params on the
        // link itself.
        document.addEventListener('click', function (event) {
          var link = event.target && event.target.closest && event.target.closest('a[href*="app.packstack.io"]');
          if (!link) return;
          try {
            var url = new URL(link.href);
            KEYS.forEach(function (k) { if (stored[k] && !url.searchParams.has(k)) url.searchParams.set(k, stored[k]); });
            url.searchParams.set('ps_ts', String(stored.ts));
            if (stored.landing) url.searchParams.set('ps_landing', stored.landing);
            link.href = url.toString();
          } catch (e) {}
        }, true);
      })();
    </script>

    <!-- Google Ads conversion tracking -->
    <!-- Fires on clicks to the web app sign up and the App Store / Google Play links. These are
         clicks, not sign-ups: keep this conversion action "secondary" in Google Ads. Real sign-ups
         and purchases are uploaded by the API (api/app/utils/ad_conversions.py). -->
    <script is:inline>
      (function () {
        var CONVERSION = 'AW-18325743425/eooSCJfu4vEcEMHOsqJE';
        // Href fragments that count as a conversion click.
        var MATCHERS = [
          'app.packstack.io/auth/register', // Web app "Sign Up"
          'apps.apple.com',                 // App Store download
          'play.google.com/store/apps'      // Google Play download
        ];
        document.addEventListener('click', function (event) {
          var link = event.target && event.target.closest && event.target.closest('a[href]');
          if (!link) return;
          var href = link.href || '';
          if (!MATCHERS.some(function (f) { return href.indexOf(f) !== -1; })) return;
          if (typeof gtag === 'function') {
            gtag('event', 'conversion', { send_to: CONVERSION });
          }
          // Navigation proceeds normally; gtag sends the hit via a beacon.
        });
      })();
    </script>
    <meta charSet="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <!-- iOS Safari Smart App Banner: "Open" if installed, "View" otherwise. Native, dismissible, not an SEO interstitial. -->
    <meta name="apple-itunes-app" content={`app-id=6760873801, app-argument=${Astro.url.href}`} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content="https://packstack.io/packstack-social-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://packstack.io/packstack-social-image.png" />
    <meta name="description" content={description} />
    <meta name="keywords" content="backpacking packing list, ultralight hiking, gear tracker, pack weight, base weight, gear inventory, hiking gear list, lighterpack alternative" />
    <title>{title}</title>
    <script async src="https://plausible.io/js/pa-nj_3h0ADLXhz02-M6THrT.js"></script>
    <script>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
    <script src="https://analytics.ahrefs.com/analytics.js" data-key="bI0QvEVR1cJ/qLscNnrLUQ" async></script>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <slot name="body-scripts" />
  </body>
</html>
