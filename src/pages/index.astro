    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="bg-background">
    <PageHeader maxWidth="6xl" />

    <!-- Hero -->
    <section class="relative pt-16 pb-8 md:pt-24 md:pb-16 px-4 overflow-hidden">
      <!-- Generative ridge backdrop -->
      <div class="absolute inset-x-0 top-0 h-[300px] md:h-[460px] pointer-events-none" aria-hidden="true">
        <svg
          viewBox={`0 0 ${RIDGE_W} ${RIDGE_H}`}
          preserveAspectRatio="xMidYMin slice"
          class="w-full h-full text-primary"
        >
          {ridgeLines.map(({ points, opacity }) => (
            <polyline
              points={points}
              fill="none"
              stroke="currentColor"
              stroke-width="1"
              opacity={opacity}
            />
          ))}
