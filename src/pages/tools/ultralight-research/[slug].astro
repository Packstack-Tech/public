---
import BaseLayout from "../../../layouts/BaseLayout.astro"
import PageHeader from "../../../components/PageHeader.astro"
import PageFooter from "../../../components/PageFooter.astro"
import GearTable from "../../../components/ultralight/GearTable"
import { API_BASE, getAllSubcategories } from "../../../utils/catalog"

export const prerender = true

export function getStaticPaths() {
  return getAllSubcategories().map((entry) => ({
    params: { slug: entry.slug },
    props: { subcategory: entry.subcategory, displayName: entry.displayName, pluralName: entry.pluralName, category: entry.category },
  }))
}

const { slug } = Astro.params
const { subcategory, displayName, pluralName, category } = Astro.props
const title = `${pluralName} — Ultralight Gear Research | Packstack`
const description = `Compare ${pluralName} by weight across ${category} products. See specs, variants, and find the lightest options for your ultralight backpacking kit.`

let initialData = null
try {
  const res = await fetch(`${API_BASE}/resources/catalog/browse/${slug}`)
  if (res.ok) initialData = await res.json()
} catch {}

const jsonLd = initialData ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": pluralName,
  "description": description,
  "numberOfItems": initialData.product_count,
  "itemListElement": initialData.products.slice(0, 50).map((p: any, i: number) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": `${p.brand_name} ${p.product_name}`,
    "url": p.product_url || undefined,
  })),
}) : null
---

<BaseLayout title={title} description={description}>
  <div class="bg-background min-h-screen">
    <PageHeader maxWidth="6xl" />

    <main class="max-w-6xl mx-auto px-4 md:px-8 py-12">
      <nav class="flex items-center gap-2 text-sm text-label mb-6">
        <a href="/tools" class="hover:text-softwhite transition-colors no-underline">Tools</a>
        <span>/</span>
        <a href="/tools/ultralight-research" class="hover:text-softwhite transition-colors no-underline">Ultralight Research</a>
        <span>/</span>
        <span class="text-softwhite">{displayName}</span>
      </nav>

      <h1 class="text-3xl md:text-4xl font-bold mb-2">{pluralName}</h1>
      <p class="text-lg mb-8 max-w-2xl">
        Browse and compare the lightest {pluralName} for ultralight backpacking. Sort by weight, filter by brand, and find the best {category} options for your loadout.
      </p>

      <GearTable client:load slug={slug!} subcategory={subcategory} category={category} initialData={initialData} />
    </main>

    <PageFooter />
  </div>
  {jsonLd && <script type="application/ld+json" set:html={jsonLd} slot="head" />}
</BaseLayout>
