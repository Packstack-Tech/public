import BaseLayout from "../layouts/BaseLayout.astro"
import PageHeader from "../components/PageHeader.astro"
import PageFooter from "../components/PageFooter.astro"

export const prerender = true

// --- Generative mountain ridge -------------------------------------------
// Rendered at build time: layered value noise traces a main ridge line,
// then repeats it downward with re-noised trajectories and fading opacity,
// like elevation contours falling away from the ridge.

function mulberry32(seed: number) {
  return () => {
    seed |= 0
    seed = (seed + 0x6d2b79f5) | 0
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed)
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296
  }
}

function makeNoise(seed: number) {
  const rand = mulberry32(seed)
  const grid = Array.from({ length: 256 }, () => rand())
  return (x: number) => {
    const i = Math.floor(x)
    const f = x - i
    const u = f * f * (3 - 2 * f) // smoothstep
    return grid[i & 255] * (1 - u) + grid[(i + 1) & 255] * u
  }
}

const RIDGE_W = 1600
const RIDGE_H = 460
const RIDGE_LINES = 26
const noise = makeNoise(42)

const ridgeLines = Array.from({ length: RIDGE_LINES }, (_, line) => {
  const baseY = 165 + line * 11
  // The ridge crest is brightest; lines fade as they descend
  const opacity = line === 0 ? 0.5 : 0.3 * (1 - line / RIDGE_LINES)
  const pts: string[] = []
  for (let x = 0; x <= RIDGE_W; x += 8) {
    // fBm: broad hills + medium ridges + fine jitter, with a per-line
    // offset so each contour drifts slightly off the one above it
    const y =
      baseY -
      noise(x * 0.0035 + line * 0.16) * 105 -
      noise(x * 0.014 + line * 0.42) * 32 -
      noise(x * 0.055 + line * 1.1) * 9
    pts.push(`${x},${y.toFixed(1)}`)
  }
  return { points: pts.join(" "), opacity: Number(opacity.toFixed(3)) }
})

// --- FAQ -------------------------------------------------------------------

const faqs = [
  {
    q: "Is Packstack free?",
    a: "Packstack is free to start. Create an account and begin building your gear closet and gear lists, no credit card required — including your first kit. Packstack Pro unlocks unlimited kits, unlimited packing lists, and the Calorie Calculator.",
  },
  {
    q: "Can I import my gear list from LighterPack?",
    a: "Yes. Export your LighterPack list as a CSV and import it into Packstack in seconds. Your items, categories, and weights come along with it.",
  },
  {
    q: "Is there a mobile app?",
    a: "Yes. Packstack is available on iOS and Android, and the web app works on any device. Build your list at home, then check items off from your phone as you pack.",
  },
  {
    q: "How is the calorie estimate calculated?",
    a: "Packstack combines your body stats (weight, height, age, sex, body type) with your trip details (distance, elevation gain, terrain, pace, temperature, and pack weight) to estimate your daily calorie burn, food weight, and water needs.",
  },
  {
    q: "What's the difference between base weight, worn weight, and consumables?",
    a: "Base weight is everything in your pack excluding food, water, and fuel. Worn weight covers items you wear or carry on your body, like shoes and trekking poles. Consumables are things you use up along the way. Packstack tracks all three separately so you know exactly what you're hauling.",
  },
]

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
}
---

<BaseLayout
  title="Packstack | Backpacking Gear List Builder & Pack Weight Tracker"
  description="Build your backpacking gear list, track base weight down to the gram, and plan food and water with Packstack — the free gear list app for backpackers and ultralight hikers. Import from LighterPack in seconds."
>
